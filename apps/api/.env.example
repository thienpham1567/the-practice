# Cổng API (web proxy /api → cổng này). Không đặt tên PORT: tiến trình cha
# thường đặt sẵn biến đó và dotenv không ghi đè biến đã tồn tại.
API_PORT=3000

# Origin của web dev server, dùng cho CORS
WEB_ORIGIN=http://localhost:5173

# PostgreSQL — khớp với docker-compose.yml
DATABASE_URL="postgresql://writing_helper:writing_helper@localhost:5432/writing_helper?schema=public"

# Database riêng cho e2e; bộ test sẽ TRUNCATE nó giữa các test
TEST_DATABASE_URL="postgresql://writing_helper:writing_helper@localhost:5432/writing_helper_test?schema=public"

# Secret ký access token (JWT, sống 15 phút). Đổi thành chuỗi ngẫu nhiên dài khi
# dùng thật: openssl rand -hex 32
# Refresh token không phải JWT — nó là chuỗi ngẫu nhiên, DB chỉ giữ hash — nên
# không cần secret riêng cho nó.
JWT_ACCESS_SECRET=

# AI rewrite qua OpenRouter (thêm ở milestone 5).
# Bỏ trống → /ai/status trả về tắt → web ẩn nút "Fix with AI".
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5

# Quyết định cờ `secure` của refresh-token cookie (auth.controller.ts). Để
# trống ở dev (cookie không cần https trên localhost); đặt "production" khi
# deploy thật, nếu không cookie sẽ không có cờ secure trên HTTPS.
NODE_ENV=
