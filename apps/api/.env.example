# Port của API (mặc định 3000; web proxy /api → cổng này)
PORT=3000

# PostgreSQL — khớp với docker-compose.yml (thêm ở milestone 3)
DATABASE_URL="postgresql://writing_helper:writing_helper@localhost:5432/writing_helper?schema=public"

# JWT secrets (thêm ở milestone 3) — đổi thành chuỗi ngẫu nhiên dài khi dùng thật
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AI rewrite qua OpenRouter (thêm ở milestone 5).
# Bỏ trống → /ai/status trả về tắt → web ẩn nút "Fix with AI".
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5
